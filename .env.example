# Copy to .env (git-ignored) and fill in. Only needed to RE-RUN judges; re-scoring needs no keys.
GEMINI_API_KEY=            # Google AI Studio key, for --judge-provider gemini
TYPE_SET_API_KEY=          # TypeSafe JEV key, for jev_judge.py / jev_probe.py (official api.typesafe.ai endpoint)
# Opus judge: uses the `claude` CLI (Claude Code) on PATH, logged in; no key needed here.
